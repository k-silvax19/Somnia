{
  "info": {
    "name": "Somnia - Catalogo Spotify",
    "description": "Execute 01 uma vez, depois 02 a 10 em ordem. Edite email, username e password nas variaveis da colecao para uma conta local de teste. O login salva accessToken; busca e detalhes salvam IDs automaticamente. Catalogo usa GET sem corpo JSON. Nao compartilhe exportacoes contendo tokens ou senhas preenchidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:7201",
      "type": "string"
    },
    {
      "key": "email",
      "value": "catalogo.teste@example.com",
      "type": "string"
    },
    {
      "key": "username",
      "value": "catalogo_teste",
      "type": "string"
    },
    {
      "key": "password",
      "value": "SomniaTeste@2026!",
      "type": "string"
    },
    {
      "key": "q",
      "value": "Radiohead",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "albumId",
      "value": "",
      "type": "string"
    },
    {
      "key": "trackId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Cadastro (execute uma vez por conta)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Somnia-Client",
            "value": "web"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"displayName\": \"Teste Catalogo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Login e salvar token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Somnia-Client",
            "value": "web"
          }
        ],
        "url": "{{baseUrl}}/api/auth/login",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const token = pm.response.json().accessToken;",
              "  pm.test(\"JWT recebido\", function () { pm.expect(token).to.be.a(\"string\").and.not.empty; });",
              "  if (token) pm.collectionVariables.set(\"accessToken\", token);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 - Buscar albuns e salvar albumId",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=album&limit=10&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const page = pm.response.json();",
              "  pm.test(\"Busca retornou albuns\", function () { pm.expect(page.items).to.be.an(\"array\").and.not.empty; });",
              "  if (page.items.length) pm.collectionVariables.set(\"albumId\", page.items[0].externalId);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 - Detalhar album e salvar trackId",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/albums/{{albumId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
              "  const album = pm.response.json();",
              "  pm.test(\"Album possui faixas\", function () { pm.expect(album.tracks).to.be.an(\"array\").and.not.empty; });",
              "  if (album.tracks.length) pm.collectionVariables.set(\"trackId\", album.tracks[0].externalId);",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 - Detalhar faixa do album",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/tracks/{{trackId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 - Buscar faixas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=track&limit=10&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 - Segunda pagina de albuns",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=album&limit=10&offset=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 - Tipo invalido (400 esperado)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=artist&limit=10&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "09 - Limite invalido (400 esperado)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=album&limit=11&offset=0"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", function () { pm.response.to.have.status(400); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "10 - Sem JWT (401 esperado)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/catalog/search?q={{q}}&type=album",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "response": []
    }
  ]
}
