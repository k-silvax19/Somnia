{
  "name": "somnia",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/setup-https.mjs",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration e2e --port 4300",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:api": "python e2e/run-real-api.py",
    "format:check": "prettier --check src e2e scripts playwright.config.ts *.json *.md"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "^1.65.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
